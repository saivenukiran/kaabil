# The prototype needs NO keys: `docker compose up` starts it with this file absent.
# These names are reserved for the finale build and are read only by a server-side
# proxy, never by the browser bundle. Leave them empty here and never commit real values.
CLOUD_STT_API_KEY=
VISION_API_KEY=

# Optional settings for docker compose (none is a secret; compose has defaults).
# KAABIL_BASE_URL=http://localhost:8080        the address people open; set it to your tunnel address for a phone
# KAABIL_TRUSTED_ORIGINS=                      extra allowed origins, comma separated
# KAABIL_DEV_CONSOLE=1                         the plain test console at /dev; set 0 in any real deployment
# KAABIL_TZ=Asia/Kolkata                       the time zone medicine times are read in
