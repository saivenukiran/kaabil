{
  "name": "kaabil",
  "private": true,
  "version": "0.1.0",
  "description": "Kaabil Hain Hum: voice-first medicine and scam-safety companion (Round 2 prototype)",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@kaabil/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bash scripts/hooks/pre-push --local",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}
